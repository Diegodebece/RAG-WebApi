# Copy to .env and replace change-me with a long random password (letters and digits only,
# so it can go in the URLs unescaped). docker-compose.yml reads POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgres://rag:change-me@localhost:5432/rag

# Tests empty this database on every run; it must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgres://rag:change-me@localhost:5432/rag_test

# Signs the login tokens. Use a different long random value, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=change-me

# Optional (defaults shown)
# PORT=3000
# HOST=127.0.0.1                         use 0.0.0.0 inside Docker
# OLLAMA_BASE_URL=http://localhost:11434 use http://host.docker.internal:11434 inside Docker
# OLLAMA_TIMEOUT_MS=120000
# TOKEN_LIFETIME_SECONDS=3600
# REGISTRATIONS_PER_HOUR=3
# REGISTRATION_ATTEMPTS_PER_HOUR=20
# LOGINS_PER_15_MINUTES=10
# FAILED_LOGINS_PER_EMAIL_PER_15_MINUTES=5   counted per email and address
# MAX_DOCUMENTS_PER_USER=3
# MAX_UPLOADS_PER_DAY=3                  accepted uploads in the last 24 hours, deleted ones included
# MAX_DOCUMENT_CHARS=200000
# QUESTIONS_PER_MINUTE=10
# MAX_QUESTIONS_PER_DAY=30                accepted questions in the last 24 hours
# MAX_QUESTION_WAIT_SECONDS=60           longest wait for the model before a 503
# MAX_WAITING_QUESTIONS=20
# MAX_QUEUED_JOBS=20
# DOCUMENT_LIFETIME_HOURS=24
