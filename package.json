{
    "name": "rag-web-api",
    "version": "0.1.0",
    "description": "Self-hosted RAG API: upload a document, ask questions, get cited answers.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "migrate": "tsx src/migrate.ts",
        "build": "tsc",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 \"test/**/*.test.ts\""
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "joi": "^18.3.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1"
    }
}
