{
    "name": "rag-web-api",
    "version": "0.1.0",
    "description": "Self-hosted RAG API: upload a document, ask questions, get cited answers.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "migrate": "tsx src/migrate.ts",
        "build": "tsc",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 \"test/**/*.test.ts\""
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "dotenv": "^18.0.7",
        "pg": "^8.23.1"
    }
}
