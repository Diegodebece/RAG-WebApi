{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|WebFetch|EnterWorktree|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-github.mjs\"",
                        "timeout": 10,
                        "onFailure": "block"
                    }
                ]
            }
        ]
    }
}
